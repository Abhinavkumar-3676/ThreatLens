# ThreatLens Environment Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="change-this-to-a-random-secret-in-production"
SESSION_MAX_AGE=86400

# Demo Mode (set to "false" in production)
DEMO_MODE="true"

# Optional: AI Provider (leave empty to use template-based analysis)
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""

# Optional: VirusTotal API
# VIRUSTOTAL_API_KEY=""

# Server
NEXT_PUBLIC_APP_NAME="ThreatLens"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
